# Copia este archivo como .env y completa tu API key. Nunca subas el .env a GitHub.
OPENAI_API_KEY=sk-...
# Proveedor: openai | fake (offline, sin costo)
LLM_PROVIDER=openai
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
TOP_K=4
# Precios USD por 1M de tokens (verifica los vigentes en la web de OpenAI)
PRICE_INPUT_PER_1M=0.15
PRICE_OUTPUT_PER_1M=0.60
PRICE_EMBEDDING_PER_1M=0.02
# Orígenes permitidos para CORS, separados por coma (ej. https://mi-app.vercel.app). * = cualquiera
ALLOWED_ORIGINS=*